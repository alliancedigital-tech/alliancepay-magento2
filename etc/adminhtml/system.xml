<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="alliance_payment_config"
                   translate="label"
                   type="text"
                   sortOrder="1000"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>Alliance Payment</label>
                <field id="enabled"
                       translate="label"
                       type="select"
                       sortOrder="5"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title"
                       translate="label"
                       type="text"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="1">
                    <label>Title</label>
                    <config_path>payment/alliance_payment_config/title</config_path>
                </field>
                <field id="api_url"
                       translate="label"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>API URL</label>
                    <validate>required-entry validate-url</validate>
                </field>
                <field id="status_page_type"
                       translate="label"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>Status Payment Page Type</label>
                    <source_model>Alliance\AlliancePay\Model\Config\Source\StatusPageType</source_model>
                </field>
                <field id="payment_type"
                       translate="label"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>Payment Type</label>
                    <source_model>Alliance\AlliancePay\Model\Config\Source\PaymentType</source_model>
                    <comment><![CDATA[<strong style="color: red;">Note:</strong> A2A payment type supports <strong style="color: red;">UAH only</strong>. If the store base currency is not UAH, A2A payments will not work correctly.]]></comment>
                </field>
                <field id="merchant_id"
                       translate="label"
                       type="text"
                       sortOrder="40"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>Merchant Id</label>
                    <validate>required-entry</validate>
                </field>
                <field id="jws_private_key"
                       translate="label"
                       type="textarea"
                       sortOrder="50"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>JWS Private Key</label>
                    <comment>RSA private key in PEM format (PKCS#8, "-----BEGIN PRIVATE KEY-----") used to sign JWS requests (RS256). Keep secret.</comment>
                    <validate>required-entry</validate>
                </field>
                <field id="jws_key_id"
                       translate="label"
                       type="text"
                       sortOrder="60"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>JWS Key ID</label>
                    <comment>Key ID (kid) of the JWS Private Key, as registered with the bank.</comment>
                    <validate>required-entry</validate>
                </field>
                <field id="pre_auth_exp_date"
                       translate="label"
                       type="select"
                       sortOrder="75"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>PreAuth Expiration Period</label>
                    <source_model>Alliance\AlliancePay\Model\Config\Source\PreAuthExpDate</source_model>
                    <depends>
                        <field id="payment_type">PREAUTH</field>
                    </depends>
                </field>
                <field id="pre_auth_order_status"
                       translate="label"
                       type="select"
                       sortOrder="80"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="1">
                    <label>PreAuth Created Order Status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status</source_model>
                    <depends>
                        <field id="payment_type">PREAUTH</field>
                    </depends>
                </field>
                <field id="pre_auth_capture_success_status"
                       translate="label"
                       type="select"
                       sortOrder="81"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="1">
                    <label>PreAuth Capture Success Order Status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status</source_model>
                    <depends>
                        <field id="payment_type">PREAUTH</field>
                    </depends>
                </field>
                <field id="success_order_status"
                       translate="label"
                       type="select"
                       sortOrder="82"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="1">
                    <label>Successful Payment Order Status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status</source_model>
                </field>
                <field id="failed_order_status"
                       translate="label"
                       type="select"
                       sortOrder="83"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="1">
                    <label>Failed Payment Order Status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status</source_model>
                </field>
                <field id="success_refund_order_status"
                       translate="label"
                       type="select"
                       sortOrder="84"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="1">
                    <label>Successful Refund Order Status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status</source_model>
                </field>
                <field id="failed_refund_order_status"
                       translate="label"
                       type="select"
                       sortOrder="85"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="1">
                    <label>Failed Refund Order Status</label>
                    <source_model>Magento\Sales\Model\Config\Source\Order\Status</source_model>
                </field>
                <field id="is_logs_enabled"
                       translate="label"
                       type="select"
                       sortOrder="120"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>Enable Payment Logs</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="alliance_subscription_config"
                   translate="label"
                   type="text"
                   sortOrder="1010"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>Alliance Subscriptions</label>
                <field id="reprice_lead_time_days"
                       translate="label"
                       type="text"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>Reprice Lead Time (days)</label>
                    <comment>Minimum number of days between a mass reprice action and the date new rules take effect.</comment>
                    <validate>required-entry validate-digits</validate>
                </field>
                <field id="recurring_amount_field_path"
                       translate="label"
                       type="text"
                       sortOrder="30"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>Recurring Payment Amount Field Path</label>
                    <comment>Dotted path to the payment amount field inside a recurring callback operation object. Not officially confirmed by the provider; adjust if needed.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
