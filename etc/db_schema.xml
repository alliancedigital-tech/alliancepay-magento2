<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="alliance_checkout_integration_order" resource="default" engine="innodb"
           comment="Alliance Checkout Integration Order Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="order_id" unsigned="false" nullable="false" identity="false"
                comment="Order ID"/>
        <column xsi:type="varchar" name="merchant_request_id" nullable="false" length="255"
                comment="Merchant Request ID"/>
        <column xsi:type="varchar" name="hpp_order_id" nullable="false" length="255"
                comment="HPP Order ID"/>
        <column xsi:type="varchar" name="merchant_id" nullable="false" length="255"
                comment="Merchant ID"/>
        <column xsi:type="int" name="coin_amount" unsigned="false" nullable="false"
                comment="Coin Amount"/>
        <column xsi:type="varchar" name="hpp_pay_type" nullable="false" length="50"
                comment="HPP Pay Type"/>
        <column xsi:type="varchar" name="order_status" nullable="false" length="50"
                comment="Order Status"/>
        <column xsi:type="text" name="payment_methods" nullable="false"
                comment="Payment Methods"/>
        <column xsi:type="datetime" name="create_date" nullable="false"
                comment="Create Date"/>
        <column xsi:type="datetime" name="updated_at" nullable="true"
                comment="Updated At"/>
        <column xsi:type="varchar" name="operation_id" nullable="true" length="255"
                comment="Operation ID"/>
        <column xsi:type="smallint" name="transaction_type" nullable="true" unsigned="true" comment="transactionType"/>
        <column xsi:type="varchar" name="ecom_order_id" nullable="true" length="255"
                comment="Ecom Order ID"/>
        <column xsi:type="boolean" name="is_callback_returned" nullable="false" default="false"
                comment="Is Callback Returned"/>
        <column xsi:type="text" name="callback_data" nullable="true"
                comment="Callback Data"/>
        <column xsi:type="datetime" name="expired_order_date" nullable="false"
                comment="Expired Order Date"/>
        <column xsi:type="int" name="original_authorized_amount" unsigned="true" nullable="true"
                comment="Original Authorized Amount in coins (for PREAUTH)"/>
        <column xsi:type="smallint" name="currency_code" unsigned="true" nullable="true"
                comment="Currency ISO 4217 numeric code (980=UAH, 840=USD, 978=EUR)"/>
        <column xsi:type="decimal" name="conversion_rate" scale="6" precision="15" nullable="true"
                comment="Currency conversion rate to UAH from PREAUTH callback"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ALLIANCE_CHECKOUT_INTEGRATION_ORDER_MERCHANT_REQUEST_ID" indexType="btree">
            <column name="merchant_request_id"/>
        </index>
        <index referenceId="ALLIANCE_CHECKOUT_INTEGRATION_ORDER_HPP_ORDER_ID" indexType="btree">
            <column name="hpp_order_id"/>
        </index>
        <index referenceId="ALLIANCE_CHECKOUT_INTEGRATION_ORDER_MERCHANT_ID" indexType="btree">
            <column name="merchant_id"/>
        </index>
        <index referenceId="ALLIANCE_CHECKOUT_INTEGRATION_ORDER_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
    </table>
    <table name="alliance_integration_order_refund" resource="default" engine="innodb"
           comment="Alliance Integration Order Refund Table">
        <column xsi:type="int" name="refund_id" unsigned="false" nullable="false" identity="true"
                comment="Refund ID"/>
        <column xsi:type="int" name="order_id" unsigned="false" nullable="false"
                comment="Order ID"/>
        <column xsi:type="varchar" name="type" nullable="false" length="255"
                comment="Type"/>
        <column xsi:type="varchar" name="rrn" nullable="false" length="255"
                comment="RRN"/>
        <column xsi:type="varchar" name="purpose" nullable="false" length="255"
                comment="Purpose"/>
        <column xsi:type="varchar" name="comment" nullable="false" length="255"
                comment="Comment"/>
        <column xsi:type="int" name="coin_amount" unsigned="false" nullable="false"
                comment="Coin Amount"/>
        <column xsi:type="varchar" name="merchant_id" nullable="false" length="255"
                comment="Merchant ID"/>
        <column xsi:type="varchar" name="operation_id" nullable="false" length="255"
                comment="Operation ID"/>
        <column xsi:type="varchar" name="ecom_operation_id" nullable="false" length="255"
                comment="Ecom Operation ID"/>
        <column xsi:type="varchar" name="merchant_name" nullable="true" length="255"
                comment="Merchant Name"/>
        <column xsi:type="varchar" name="approval_code" nullable="false" length="255"
                comment="Approval Code"/>
        <column xsi:type="varchar" name="status" nullable="false" length="255"
                comment="Status"/>
        <column xsi:type="int" name="transaction_type" unsigned="false" nullable="false"
                comment="Transaction Type"/>
        <column xsi:type="varchar" name="merchant_request_id" nullable="false" length="255"
                comment="Merchant Request ID"/>
        <column xsi:type="varchar" name="transaction_currency" nullable="false" length="255"
                comment="Transaction Currency"/>
        <column xsi:type="int" name="merchant_commission" unsigned="false" nullable="true"
                comment="Merchant Commission"/>
        <column xsi:type="datetime" name="create_date_time" nullable="false"
                comment="Create Date Time"/>
        <column xsi:type="datetime" name="modification_date_time" nullable="false"
                comment="Modification Date Time"/>
        <column xsi:type="varchar" name="action_code" nullable="false" length="255"
                comment="Action Code"/>
        <column xsi:type="varchar" name="response_code" nullable="false" length="255"
                comment="Response Code"/>
        <column xsi:type="varchar" name="description" nullable="false" length="255"
                comment="Description"/>
        <column xsi:type="varchar" name="processing_merchant_id" nullable="false" length="255"
                comment="Processing Merchant ID"/>
        <column xsi:type="varchar" name="processing_terminal_id" nullable="false" length="255"
                comment="Processing Terminal ID"/>
        <column xsi:type="text" name="transaction_response_info" nullable="false"
                comment="Transaction Response Info"/>
        <column xsi:type="varchar" name="bank_code" nullable="false" length="255"
                comment="Bank Code"/>
        <column xsi:type="varchar" name="payment_system" nullable="false" length="255"
                comment="Payment System"/>
        <column xsi:type="varchar" name="product_type" nullable="false" length="255"
                comment="Product Type"/>
        <column xsi:type="varchar" name="notification_url" nullable="false" length="255"
                comment="Notification URL"/>
        <column xsi:type="varchar" name="payment_service_type" nullable="false" length="255"
                comment="Payment Service Type"/>
        <column xsi:type="varchar" name="notification_encryption" nullable="false" length="255"
                comment="Notification Encryption"/>
        <column xsi:type="varchar" name="original_operation_id" nullable="false" length="255"
                comment="Original Operation ID"/>
        <column xsi:type="int" name="original_coin_amount" unsigned="false" nullable="false"
                comment="Original Coin Amount"/>
        <column xsi:type="varchar" name="original_ecom_operation_id" nullable="false" length="255"
                comment="Original Ecom Operation ID"/>
        <column xsi:type="varchar" name="rrn_original" nullable="false" length="255"
                comment="RRN Original"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="refund_id"/>
        </constraint>
        <index referenceId="ALLIANCE_INTEGRATION_ORDER_REFUND_MERCHANT_REQUEST_ID" indexType="btree">
            <column name="merchant_request_id"/>
        </index>
        <index referenceId="ALLIANCE_INTEGRATION_ORDER_REFUND_MERCHANT_ID" indexType="btree">
            <column name="merchant_id"/>
        </index>
    </table>
    <table name="alliance_subscription_plan_template" resource="default" engine="innodb"
           comment="Alliance Subscription Plan Template Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="code" nullable="false" length="64" comment="Code"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="varchar" name="category_indicator" nullable="true" length="64" comment="Category Indicator"/>
        <column xsi:type="text" name="rules_template" nullable="false" comment="Rules Template"/>
        <column xsi:type="varchar" name="status" nullable="false" length="20" default="active" comment="Status"/>
        <column xsi:type="datetime" name="created_at" nullable="false" comment="Created At"/>
        <column xsi:type="datetime" name="updated_at" nullable="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ALLIANCE_SUBSCRIPTION_PLAN_TEMPLATE_CODE">
            <column name="code"/>
        </constraint>
    </table>
    <table name="alliance_subscription_plan" resource="default" engine="innodb"
           comment="Alliance Subscription Plan Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="provider_plan_id" nullable="true" length="255" comment="Provider Plan ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Product ID"/>
        <column xsi:type="int" name="template_id" unsigned="true" nullable="true" comment="Template ID"/>
        <column xsi:type="varchar" name="plan_key" nullable="false" length="64" comment="Plan Key"/>
        <column xsi:type="boolean" name="is_active" nullable="false" default="true" comment="Is Active"/>
        <column xsi:type="int" name="active_subscriptions_count" unsigned="true" nullable="false" default="0"
                comment="Active Subscriptions Count"/>
        <column xsi:type="varchar" name="sync_status" nullable="false" length="20" default="SYNCED"
                comment="Sync Status"/>
        <column xsi:type="text" name="sync_error" nullable="true" comment="Sync Error"/>
        <column xsi:type="varchar" name="version_id" nullable="true" length="255" comment="Version ID"/>
        <column xsi:type="varchar" name="merchant_id" nullable="false" length="255" comment="Merchant ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="varchar" name="description" nullable="true" length="500" comment="Description"/>
        <column xsi:type="varchar" name="status" nullable="false" length="20" comment="Status"/>
        <column xsi:type="varchar" name="category_indicator" nullable="true" length="64" comment="Category Indicator"/>
        <column xsi:type="text" name="rules" nullable="false" comment="Rules"/>
        <column xsi:type="datetime" name="applies_from" nullable="true" comment="Applies From"/>
        <column xsi:type="datetime" name="applies_to" nullable="true" comment="Applies To"/>
        <column xsi:type="datetime" name="created_at" nullable="false" comment="Created At"/>
        <column xsi:type="datetime" name="updated_at" nullable="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ALLIANCE_SUBSCRIPTION_PLAN_PROVIDER_PLAN_ID">
            <column name="provider_plan_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ALLIANCE_SUBSCRIPTION_PLAN_PLAN_KEY">
            <column name="plan_key"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ALLIANCE_SUBSCRIPTION_PLAN_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID"
                    table="alliance_subscription_plan" column="product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="ALLIANCE_SUBSCRIPTION_PLAN_TEMPLATE_ID_ALLIANCE_SUBSCRIPTION_PLAN_TEMPLATE_ENTITY_ID"
                    table="alliance_subscription_plan" column="template_id"
                    referenceTable="alliance_subscription_plan_template" referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="ALLIANCE_SUBSCRIPTION_PLAN_PRODUCT_ID" indexType="btree">
            <column name="product_id"/>
        </index>
        <index referenceId="ALLIANCE_SUBSCRIPTION_PLAN_TEMPLATE_ID" indexType="btree">
            <column name="template_id"/>
        </index>
    </table>
    <table name="alliance_subscription" resource="default" engine="innodb"
           comment="Alliance Subscription Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Order ID"/>
        <column xsi:type="int" name="plan_id" unsigned="true" nullable="false" comment="Plan ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="text" name="rules_snapshot" nullable="false" comment="Rules Snapshot"/>
        <column xsi:type="varchar" name="provider_order_id" nullable="false" length="255" comment="Provider Order ID"/>
        <column xsi:type="varchar" name="merchant_request_id" nullable="false" length="255" comment="Merchant Request ID"/>
        <column xsi:type="varchar" name="status" nullable="false" length="20" default="PENDING" comment="Status"/>
        <column xsi:type="text" name="callback_data" nullable="true" comment="Callback Data"/>
        <column xsi:type="datetime" name="created_at" nullable="false" comment="Created At"/>
        <column xsi:type="datetime" name="updated_at" nullable="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ALLIANCE_SUBSCRIPTION_PROVIDER_ORDER_ID">
            <column name="provider_order_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ALLIANCE_SUBSCRIPTION_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="alliance_subscription" column="order_id"
                    referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="ALLIANCE_SUBSCRIPTION_PLAN_ID_ALLIANCE_SUBSCRIPTION_PLAN_ENTITY_ID"
                    table="alliance_subscription" column="plan_id"
                    referenceTable="alliance_subscription_plan" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="ALLIANCE_SUBSCRIPTION_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="alliance_subscription" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ALLIANCE_SUBSCRIPTION_PLAN_ID" indexType="btree">
            <column name="plan_id"/>
        </index>
        <index referenceId="ALLIANCE_SUBSCRIPTION_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="ALLIANCE_SUBSCRIPTION_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
        <index referenceId="ALLIANCE_SUBSCRIPTION_MERCHANT_REQUEST_ID" indexType="btree">
            <column name="merchant_request_id"/>
        </index>
    </table>
    <table name="alliance_subscription_scheduled_payment" resource="default" engine="innodb"
           comment="Alliance Subscription Scheduled Payment Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="subscription_id" unsigned="true" nullable="false" comment="Subscription ID"/>
        <column xsi:type="varchar" name="provider_order_id" nullable="false" length="255" comment="Provider Order ID"/>
        <column xsi:type="varchar" name="scheduled_payment_id" nullable="true" length="255" comment="Scheduled Payment ID"/>
        <column xsi:type="int" name="payment_number" unsigned="true" nullable="true" comment="Payment Number"/>
        <column xsi:type="varchar" name="status" nullable="false" length="20" comment="Status"/>
        <column xsi:type="datetime" name="scheduled_date" nullable="true" comment="Scheduled Date"/>
        <column xsi:type="datetime" name="executed_at" nullable="true" comment="Executed At"/>
        <column xsi:type="varchar" name="operation_id" nullable="true" length="255" comment="Operation ID"/>
        <column xsi:type="int" name="retry_count" unsigned="true" nullable="false" default="0" comment="Retry Count"/>
        <column xsi:type="varchar" name="amount_reconciliation_status" nullable="true" length="20" default="OK"
                comment="Amount Reconciliation Status"/>
        <column xsi:type="varchar" name="reconciliation_note" nullable="true" length="500" comment="Reconciliation Note"/>
        <column xsi:type="datetime" name="created_at" nullable="false" comment="Created At"/>
        <column xsi:type="datetime" name="updated_at" nullable="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ALLIANCE_SCHEDULED_PAYMENT_OPERATION_ID">
            <column name="operation_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ALLIANCE_SCHEDULED_PAYMENT_SUBSCRIPTION_ID_ALLIANCE_SUBSCRIPTION_ENTITY_ID"
                    table="alliance_subscription_scheduled_payment" column="subscription_id"
                    referenceTable="alliance_subscription" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ALLIANCE_SCHEDULED_PAYMENT_SUBSCRIPTION_ID" indexType="btree">
            <column name="subscription_id"/>
        </index>
        <index referenceId="ALLIANCE_SCHEDULED_PAYMENT_PROVIDER_ORDER_ID" indexType="btree">
            <column name="provider_order_id"/>
        </index>
        <index referenceId="ALLIANCE_SCHEDULED_PAYMENT_SCHEDULED_PAYMENT_ID" indexType="btree">
            <column name="scheduled_payment_id"/>
        </index>
        <index referenceId="ALLIANCE_SCHEDULED_PAYMENT_PROVIDER_ORDER_ID_SCHEDULED_PAYMENT_ID" indexType="btree">
            <column name="provider_order_id"/>
            <column name="scheduled_payment_id"/>
        </index>
    </table>
    <table name="alliance_subscription_plan_version_history" resource="default" engine="innodb"
           comment="Alliance Subscription Plan Version History Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="plan_id" unsigned="true" nullable="false" comment="Plan ID"/>
        <column xsi:type="varchar" name="old_version_id" nullable="true" length="255" comment="Old Version ID"/>
        <column xsi:type="varchar" name="new_version_id" nullable="true" length="255" comment="New Version ID"/>
        <column xsi:type="text" name="old_rules" nullable="true" comment="Old Rules"/>
        <column xsi:type="text" name="new_rules" nullable="false" comment="New Rules"/>
        <column xsi:type="datetime" name="applies_from" nullable="false" comment="Applies From"/>
        <column xsi:type="varchar" name="reason" nullable="true" length="500" comment="Reason"/>
        <column xsi:type="int" name="created_by" unsigned="true" nullable="true" comment="Created By"/>
        <column xsi:type="datetime" name="created_at" nullable="false" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ALLIANCE_SUBSCRIPTION_PLAN_VERSION_HISTORY_PLAN_ID_ALLIANCE_SUBSCRIPTION_PLAN_ENTITY_ID"
                    table="alliance_subscription_plan_version_history" column="plan_id"
                    referenceTable="alliance_subscription_plan" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="ALLIANCE_SUBSCRIPTION_PLAN_VERSION_HISTORY_CREATED_BY_ADMIN_USER_USER_ID"
                    table="alliance_subscription_plan_version_history" column="created_by"
                    referenceTable="admin_user" referenceColumn="user_id" onDelete="SET NULL"/>
        <index referenceId="ALLIANCE_SUBSCRIPTION_PLAN_VERSION_HISTORY_PLAN_ID" indexType="btree">
            <column name="plan_id"/>
        </index>
    </table>
    <table name="alliance_subscription_audit_log" resource="default" engine="innodb"
           comment="Alliance Subscription Audit Log Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="action" nullable="false" length="64" comment="Action"/>
        <column xsi:type="int" name="plan_id" unsigned="true" nullable="true" comment="Plan ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="true" comment="Product ID"/>
        <column xsi:type="int" name="user_id" unsigned="true" nullable="true" comment="User ID"/>
        <column xsi:type="text" name="details" nullable="true" comment="Details"/>
        <column xsi:type="datetime" name="created_at" nullable="false" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ALLIANCE_SUBSCRIPTION_AUDIT_LOG_PLAN_ID_ALLIANCE_SUBSCRIPTION_PLAN_ENTITY_ID"
                    table="alliance_subscription_audit_log" column="plan_id"
                    referenceTable="alliance_subscription_plan" referenceColumn="entity_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign" referenceId="ALLIANCE_SUBSCRIPTION_AUDIT_LOG_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID"
                    table="alliance_subscription_audit_log" column="product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign" referenceId="ALLIANCE_SUBSCRIPTION_AUDIT_LOG_USER_ID_ADMIN_USER_USER_ID"
                    table="alliance_subscription_audit_log" column="user_id"
                    referenceTable="admin_user" referenceColumn="user_id" onDelete="SET NULL"/>
        <index referenceId="ALLIANCE_SUBSCRIPTION_AUDIT_LOG_PLAN_ID" indexType="btree">
            <column name="plan_id"/>
        </index>
        <index referenceId="ALLIANCE_SUBSCRIPTION_AUDIT_LOG_ACTION" indexType="btree">
            <column name="action"/>
        </index>
        <index referenceId="ALLIANCE_SUBSCRIPTION_AUDIT_LOG_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
