<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_components.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">alliance_scheduled_payment_listing.alliance_scheduled_payment_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>alliance_scheduled_payment_columns</spinner>
        <deps>
            <dep>alliance_scheduled_payment_listing.alliance_scheduled_payment_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="alliance_scheduled_payment_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Alliance\AlliancePay\Model\ScheduledPaymentGridDataProvider</argument>
            <argument name="name" xsi:type="string">alliance_scheduled_payment_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
            </item>
        </argument>
    </dataSource>
    <columns name="alliance_scheduled_payment_columns">
        <column name="entity_id">
            <settings>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="subscription_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Subscription ID</label>
            </settings>
        </column>
        <column name="provider_order_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Provider Order ID</label>
            </settings>
        </column>
        <column name="scheduled_payment_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Scheduled Payment ID</label>
            </settings>
        </column>
        <column name="status">
            <settings>
                <filter>text</filter>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="scheduled_date" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Scheduled Date</label>
            </settings>
        </column>
        <column name="executed_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Executed At</label>
            </settings>
        </column>
        <column name="retry_count">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Retry Count</label>
            </settings>
        </column>
        <column name="amount_reconciliation_status">
            <settings>
                <filter>text</filter>
                <label translate="true">Amount Reconciliation</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Alliance\AlliancePay\Ui\Component\Listing\Column\ScheduledPaymentActions">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
